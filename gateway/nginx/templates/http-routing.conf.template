# --- NewLinkAF (ticket.newlinkaf.com) ---
# Upstream is the NewLinkAF nginx container on the shared public-proxy network
# (alias newlinkaf-nginx). Do NOT use host.docker.internal:9080 — Linux Docker
# cannot reach processes bound only to 127.0.0.1 via the host-gateway IP.
server {
    listen 80;
    listen [::]:80;
    server_name ticket.newlinkaf.com;

    location / {
        proxy_pass http://${NEWLINKAF_HTTP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}

