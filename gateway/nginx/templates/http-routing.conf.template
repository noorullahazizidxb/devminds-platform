# Gateway self-check (used by docker healthcheck).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location = /gateway-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'gateway-ok';
    }

    location / {
        return 444;
    }
}
