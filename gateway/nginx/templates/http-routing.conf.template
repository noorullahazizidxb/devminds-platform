# --- DevMinds platform ---
# Upstream is devminds-nginx on public-proxy (alias devminds-internal-nginx).
server {
    listen 80;
    listen [::]:80;
    server_name
        devminds.net
        www.devminds.net
        jobs.devminds.net
        marketplace.devminds.net;

