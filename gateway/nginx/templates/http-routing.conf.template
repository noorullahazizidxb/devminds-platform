# --- NewLinkAF (ticket.newlinkaf.com) ---
server {
    listen 80;
    listen [::]:80;
    server_name ticket.newlinkaf.com;

    location / {
        proxy_pass http://${NEWLINKAF_HTTP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
    }
}

# --- DevMinds platform ---
server {
    listen 80;
    listen [::]:80;
    server_name
        devminds.net
        www.devminds.net
        jobs.devminds.net
        marketplace.devminds.net
        marketplace.devminds.com
        noorullah-azizi-ceo.devminds.net;

    location / {
        proxy_pass http://${DEVMINDS_HTTP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
    }
