log_format basic '$remote_addr [$time_local] $protocol $status $bytes_sent $bytes_received '
                 '$session_time "$ssl_preread_server_name"';

access_log /var/log/nginx/stream-access.log basic;

# Docker embedded DNS — required because proxy_pass uses a variable ($https_upstream).
# Without this, SNI routing cannot resolve container hostnames and clients see
# "Connection reset by peer" on :443 while HTTP (literal proxy_pass) still works.
resolver 127.0.0.11 valid=10s ipv6=off;

map $ssl_preread_server_name $https_upstream {
    ticket.newlinkaf.com              ${NEWLINKAF_HTTPS_UPSTREAM};

    devminds.net                      ${DEVMINDS_HTTPS_UPSTREAM};
    www.devminds.net                  ${DEVMINDS_HTTPS_UPSTREAM};
    jobs.devminds.net                 ${DEVMINDS_HTTPS_UPSTREAM};
    marketplace.devminds.net          ${DEVMINDS_HTTPS_UPSTREAM};

    default                           ${DEVMINDS_HTTPS_UPSTREAM};
}

server {
    listen 443;
    listen [::]:443;
    proxy_pass $https_upstream;
    ssl_preread on;
    proxy_connect_timeout 5s;
    proxy_timeout 300s;
}
