# DevMinds platform — LOCALHOST template
# Deploy scripts copy this file to .env (active runtime file).
# Local-only secrets — do not use these values on a public VPS.
#
# Local access is IP + ports (see docker-compose.local.yml). Nginx/domains are production-only.
# Notes:
# - MYSQL_USER must stay "devminds" (mysql/init grants are hardcoded to that user).
# - Keep REDIS_PASSWORD and REDIS_URL in sync (include :password@ when password is set).
# - Leave ELASTICSEARCH_USERNAME empty — cluster runs with xpack.security.enabled=false.
# - NEXT_PUBLIC_* are baked into frontend images at build time; rebuild frontends after changes.
# - For LAN access from another device, set LOCAL_PUBLIC_HOST below and update all NEXT_PUBLIC_*
#   URLs to that IP, then redeploy so frontend images rebuild.

COMPOSE_PROJECT_NAME=devminds-platform

# Host used by the browser for local IP:port URLs (127.0.0.1 or your LAN IP)
LOCAL_PUBLIC_HOST=127.0.0.1

# Published local ports (must match docker-compose.local.yml)
LOCAL_JOBS_UI_PORT=3001
LOCAL_MARKETPLACE_UI_PORT=3002
LOCAL_JOBS_API_PORT=4001
LOCAL_MARKETPLACE_API_PORT=4002

# Domains kept for documentation / production templates only (unused locally)
LANDING_DOMAIN=devminds.net
JOBS_DOMAIN=jobs.devminds.net
MARKETPLACE_DOMAIN=marketplace.devminds.com
MARKETPLACE_ALIAS_DOMAIN=marketplace.devminds.net

# Shared MySQL — one database per app
MYSQL_ROOT_PASSWORD=LocalRootPassword123
MYSQL_USER=devminds
MYSQL_PASSWORD=LocalAppPassword123
DATABASE_URL_JOBS=mysql://devminds:LocalAppPassword123@mysql:3306/job_portal
DATABASE_URL_MARKETPLACE=mysql://devminds:LocalAppPassword123@mysql:3306/marketplace

# Shared Redis
REDIS_PASSWORD=LocalRedisPassword123
REDIS_URL=redis://:LocalRedisPassword123@redis:6379

# Shared Elasticsearch (security off in compose)
ENABLE_ELASTIC_SEARCH=true
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ALLOW_SELF_SIGNED=false
ES_COMPATIBILITY=8
ELASTICSEARCH_INDEX=marketplace-listings
ELASTICSEARCH_USERS_INDEX=marketplace-users
ELASTICSEARCH_BLOGS_INDEX=marketplace-blogs
ES_INDEX_COMPANIES=jobs-companies
ES_INDEX_JOBS=jobs-jobs
ES_INDEX_SERVICES=jobs-services
ES_INDEX_USERS=jobs-users
ES_INDEX_APPLICATIONS=jobs-applications

# Application secrets (local only)
TOKEN_SECRET=LocalMarketplaceTokenSecret
JWT_SECRET=LocalJobsJwtSecret
SESSION_SECRET=LocalSessionSecret
AUTH_COOKIE_SECRET=LocalCookieSecret

# Seed and reindex controls (first local boot)
RUN_JOBS_SEEDS=false
RUN_MARKETPLACE_ADMIN_SEED=true
RUN_MARKETPLACE_DEMO_SEEDS=false
RUN_ES_REINDEX=false
ADMIN_EMAIL=admin@devminds.net
ADMIN_PHONE=
ADMIN_PASSWORD=LocalAdminPassword123
SEED_USER_PASSWORD=LocalDemoUserPassword123

# Jobs queues and file processing
QUEUE_PREFIX=job-portal
GHOSTSCRIPT_ENABLED=false

# Optional Marketplace integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@devminds.net
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# Browser-visible values (build-time) — HTTP IP:ports for localhost
NEXT_PUBLIC_JOBS_API_BASE=http://127.0.0.1:4001
NEXT_PUBLIC_MARKETPLACE_API_BASE=http://127.0.0.1:4002/api
NEXT_PUBLIC_MARKETPLACE_WS_URL=http://127.0.0.1:4002
NEXT_PUBLIC_MARKETPLACE_SITE_URL=http://127.0.0.1:3002
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=true
