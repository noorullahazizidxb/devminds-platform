# DevMinds platform environment template
# Copy to .env and replace every ChangeMe value before deployment.

COMPOSE_PROJECT_NAME=devminds-platform

# Public domains
LANDING_DOMAIN=devminds.net
JOBS_DOMAIN=jobs.devminds.net
MARKETPLACE_DOMAIN=marketplace.devminds.com
MARKETPLACE_ALIAS_DOMAIN=marketplace.devminds.net

# One shared MySQL instance, with one database per application
MYSQL_ROOT_PASSWORD=ChangeMeRootPassword123
MYSQL_USER=devminds
MYSQL_PASSWORD=ChangeMeAppPassword123
DATABASE_URL_JOBS=mysql://devminds:ChangeMeAppPassword123@mysql:3306/job_portal
DATABASE_URL_MARKETPLACE=mysql://devminds:ChangeMeAppPassword123@mysql:3306/marketplace

# One shared Redis instance. Keep REDIS_URL and REDIS_PASSWORD consistent.
REDIS_PASSWORD=ChangeMeRedisPassword123
REDIS_URL=redis://:ChangeMeRedisPassword123@redis:6379

# One shared Elasticsearch instance; index prefixes prevent cross-app collisions.
ENABLE_ELASTIC_SEARCH=true
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ALLOW_SELF_SIGNED=false
ES_COMPATIBILITY=8
ELASTICSEARCH_INDEX=marketplace-listings
ELASTICSEARCH_USERS_INDEX=marketplace-users
ELASTICSEARCH_BLOGS_INDEX=marketplace-blogs
ES_INDEX_COMPANIES=jobs-companies
ES_INDEX_JOBS=jobs-jobs
ES_INDEX_SERVICES=jobs-services
ES_INDEX_USERS=jobs-users
ES_INDEX_APPLICATIONS=jobs-applications

# Application secrets
TOKEN_SECRET=ChangeMeMarketplaceTokenSecret
JWT_SECRET=ChangeMeJobsJwtSecret
SESSION_SECRET=ChangeMeSessionSecret
AUTH_COOKIE_SECRET=ChangeMeCookieSecret

# Seed and reindex controls
RUN_JOBS_SEEDS=false
RUN_MARKETPLACE_ADMIN_SEED=true
RUN_MARKETPLACE_DEMO_SEEDS=false
RUN_ES_REINDEX=false
ADMIN_EMAIL=admin@devminds.net
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMeAdminPassword123
SEED_USER_PASSWORD=ChangeMeDemoUserPassword123

# Jobs queues and file processing
QUEUE_PREFIX=job-portal
GHOSTSCRIPT_ENABLED=false

# Optional Marketplace integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@devminds.net
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# Browser-visible values are baked into the frontend images at build time.
NEXT_PUBLIC_JOBS_API_BASE=https://jobs.devminds.net
NEXT_PUBLIC_MARKETPLACE_API_BASE=https://marketplace.devminds.com/api
NEXT_PUBLIC_MARKETPLACE_WS_URL=https://marketplace.devminds.com
NEXT_PUBLIC_MARKETPLACE_SITE_URL=https://marketplace.devminds.com
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=true