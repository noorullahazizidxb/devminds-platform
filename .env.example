# =============================================================================
# DevMinds Platform — environment template
# Copy to .env and adjust before deploying.
# =============================================================================

COMPOSE_PROJECT_NAME=devminds-platform

# --- Domains ---
LANDING_DOMAIN=devminds.net
JOBS_DOMAIN=jobs.devminds.net
MARKETPLACE_DOMAIN=marketplace.devminds.net

# --- MySQL (shared) ---
MYSQL_ROOT_PASSWORD=ChangeMe_Root_Password_123!
MYSQL_USER=devminds
MYSQL_PASSWORD=ChangeMe_App_Password_123!

# Connection strings used by backends (password URL-encoded if special chars)
# Example with @ encoded as %40:
DATABASE_URL_MARKETPLACE=mysql://root:ChangeMe_Root_Password_123%21@mysql:3306/marketplace
DATABASE_URL_JOBS=mysql://root:ChangeMe_Root_Password_123%21@mysql:3306/job_portal

# --- Redis (shared) ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# --- Elasticsearch (shared) ---
ENABLE_ELASTIC_SEARCH=true
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ALLOW_SELF_SIGNED=true
ES_COMPATIBILITY=8

# Marketplace ES indexes
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_USERS_INDEX=users
ELASTICSEARCH_BLOGS_INDEX=blogs

# Jobs ES indexes
ES_INDEX_COMPANIES=companies
ES_INDEX_JOBS=jobs
ES_INDEX_SERVICES=services
ES_INDEX_USERS=users
ES_INDEX_APPLICATIONS=applications

# --- Secrets ---
TOKEN_SECRET=replace_with_long_random_marketplace_token_secret
JWT_SECRET=replace_with_long_random_jobs_jwt_secret
SESSION_SECRET=replace_with_long_random_session_secret
AUTH_COOKIE_SECRET=replace_with_long_random_cookie_secret

# --- Marketplace admin seed ---
RUN_SEEDS=true
ADMIN_EMAIL=admin@devminds.net
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!

# --- Marketplace social / SMTP / Twilio (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@devminds.net
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# --- Jobs queue ---
QUEUE_PREFIX=job-portal
GHOSTSCRIPT_ENABLED=false

# --- Public frontend URLs (baked at image build) ---
NEXT_PUBLIC_JOBS_API_BASE=https://jobs.devminds.net
NEXT_PUBLIC_MARKETPLACE_API_BASE=https://marketplace.devminds.net/api
NEXT_PUBLIC_MARKETPLACE_WS_URL=https://marketplace.devminds.net
NEXT_PUBLIC_MARKETPLACE_SITE_URL=https://marketplace.devminds.net
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=true
