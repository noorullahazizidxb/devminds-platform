# DevMinds platform — PRODUCTION (VPS) template
# 1. Edit every ChangeMe* value below.
# 2. Run: ./scripts/deploy.sh production
#    (copies this file to .env — the active runtime file; .env is gitignored)
#
# Notes:
# - Nginx server_name values are hardcoded in nginx/conf.d/*.conf (domain vars are documentation only).
# - MYSQL_USER must stay "devminds" (mysql/init grants are hardcoded to that user).
# - URL-encode special characters in DATABASE_URL_* passwords (@ → %40, # → %23, etc.).
# - Keep REDIS_PASSWORD and REDIS_URL in sync.
# - Leave ELASTICSEARCH_USERNAME empty — cluster runs with xpack.security.enabled=false.
# - NEXT_PUBLIC_* are baked into frontend images at build time; rebuild frontends after changes.
# - After first successful boot, set seed/reindex flags to false (see docs/DEPLOY-VPS.md).

COMPOSE_PROJECT_NAME=devminds-platform

# Public domains (must match DNS + Nginx)
LANDING_DOMAIN=devminds.net
JOBS_DOMAIN=jobs.devminds.net
MARKETPLACE_DOMAIN=marketplace.devminds.net
MARKETPLACE_ALIAS_DOMAIN=marketplace.devminds.net

# Shared MySQL — one database per app
MYSQL_ROOT_PASSWORD=taktak
MYSQL_USER=devminds
MYSQL_PASSWORD=taktak
DATABASE_URL_JOBS=mysql://devminds:taktak@mysql:3306/job_portal
DATABASE_URL_MARKETPLACE=mysql://devminds:taktak@mysql:3306/marketplace

# Shared Redis
REDIS_PASSWORD=taktak
REDIS_URL=redis://:taktak@redis:6379

# Shared Elasticsearch (security off in compose)
ENABLE_ELASTIC_SEARCH=true
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ALLOW_SELF_SIGNED=false
ES_COMPATIBILITY=8
ELASTICSEARCH_INDEX=marketplace-listings
ELASTICSEARCH_USERS_INDEX=marketplace-users
ELASTICSEARCH_BLOGS_INDEX=marketplace-blogs
ES_INDEX_COMPANIES=jobs-companies
ES_INDEX_JOBS=jobs-jobs
ES_INDEX_SERVICES=jobs-services
ES_INDEX_USERS=jobs-users
ES_INDEX_APPLICATIONS=jobs-applications

# Application secrets — replace with unique random strings
TOKEN_SECRET=harirefathawa
JWT_SECRET=harirefathawa
SESSION_SECRET=harirefathawa
AUTH_COOKIE_SECRET=harirefathawa

# Seed and reindex controls (first production boot)
RUN_JOBS_SEEDS=true
RUN_MARKETPLACE_ADMIN_SEED=true
RUN_MARKETPLACE_DEMO_SEEDS=false
RUN_ES_REINDEX=true
ADMIN_EMAIL=noorullah.azizi2040@gmail.com
ADMIN_PHONE=077807272
ADMIN_PASSWORD=Mcitp@123
SEED_USER_PASSWORD=taktak

# Jobs queues and file processing
QUEUE_PREFIX=job-portal
GHOSTSCRIPT_ENABLED=false

# Optional Marketplace integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@devminds.net
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# Browser-visible values (build-time)
NEXT_PUBLIC_JOBS_API_BASE=https://jobs.devminds.net
NEXT_PUBLIC_MARKETPLACE_API_BASE=https://marketplace.devminds.com/api
NEXT_PUBLIC_MARKETPLACE_WS_URL=https://marketplace.devminds.com
NEXT_PUBLIC_MARKETPLACE_SITE_URL=https://marketplace.devminds.com
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=true
